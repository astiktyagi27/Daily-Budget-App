<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup rules (F-007 AC-11, D-003, D-045, D-049).
  Cloud backup (Google Drive) takes nothing from this app: no data leaves the
  phone through the cloud. Phone-to-phone transfer (cable or direct Wi-Fi when
  setting up a new phone) includes the money database and the preferences, so
  the user keeps their history.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
